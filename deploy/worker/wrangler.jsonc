// The limbo.watch Worker (docs/HOSTING_PLAN.md). Nothing here names a Cloudflare account: wrangler reads
// CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN from the environment, so the same file deploys to any account
// that has a bucket of this name.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "limbowatch-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [{ "binding": "SITE", "bucket_name": "limbowatch-site" }],
  // In the $0 setup the bucket serves the site on its custom domain and this Worker runs only on /osv/*, to add
  // X-Goog-Hash (F-073, F-180). Its routes must fail open: past the free daily limit, requests skip the Worker and
  // R2 answers. There's no config field for it and every deploy resets it, so run scripts/cf_rules.py after each
  // deploy; it sets them through the API (F-183).
  "workers_dev": false,
  "routes": [
    { "pattern": "limbo.watch/osv/*", "zone_name": "limbo.watch" },
    { "pattern": "next.limbo.watch/osv/*", "zone_name": "limbo.watch" }
  ],
  "observability": { "enabled": true }
}
